---
const { title = "Zeyad Sobh", wide = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="Zeyad Sobh, Software Engineer II at Microsoft." />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body class={wide ? "wide" : undefined}>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fafaf8;
    --fg: #1a1a1a;
    --muted: #444;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #151515;
      --fg: #ececec;
      --muted: #b0b0b0;
    }
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: var(--bg);
    color: var(--fg);
    font-family: Georgia, "Times New Roman", serif;
  }
  main {
    max-width: 32rem;
    padding: 2rem 1.25rem;
  }
  body.wide {
    place-items: start center;
  }
  body.wide main {
    max-width: 46rem;
    width: 100%;
    box-sizing: border-box;
  }
  h1 {
    font-weight: 500;
    font-size: 2.25rem;
    margin: 0 0 0.75rem;
  }
  p {
    line-height: 1.6;
    color: var(--muted);
  }
  nav {
    margin-top: 1.25rem;
    font: 0.9rem system-ui, sans-serif;
  }
  nav a {
    color: inherit;
    margin-right: 1rem;
  }
</style>
